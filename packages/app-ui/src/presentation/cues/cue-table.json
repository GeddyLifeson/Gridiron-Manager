{
  "$comment": "PV-02 event cue table. One row per presentation feed cue kind (PV-00 FEED_CUE_KINDS) plus the non-feed cues in plan section 4.2. Rank, duration and rate-limit numbers are Assumptions (presentation tuning, no football fact). Ranks: lower number wins. Era column per plan 2.1: plain is the fallback skin, classic is the default skin. No marks, music or voices of any real league, team or broadcaster.",
  "formatVersion": 1,
  "visibility": "user-visible",
  "lanes": {
    "crowdReaction": {
      "exclusive": true,
      "maxWaitMs": 0,
      "note": "One ranked crowd reaction per play. A higher rank (lower number) cuts in, a lower one is dropped (MB-7)."
    },
    "stinger": {
      "exclusive": true,
      "maxWaitMs": 1500,
      "note": "Short tones (whistle, referee tone, alerts, count, relay, confirm). Never overlap: a higher rank cuts in, a lower one waits up to maxWaitMs, then is dropped. Rank values and durations are Assumptions (tuning)."
    }
  },
