{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gridiron Manager",
  "version": "0.0.1",
  "identifier": "dev.gridironmanager.desktop",
  "build": {
    "frontendDist": "../../browser/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [{ "title": "Gridiron Manager", "width": 1100, "height": 820 }],
    "security": { "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
