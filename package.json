{
  "name": "gridiron-manager",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "shells/browser"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsx scripts/check.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsx packages/tools/src/cli.ts lint",
    "new-save": "tsx packages/tools/src/cli.ts new-save",
    "facts": "tsx packages/tools/src/cli.ts facts",
    "headless": "tsx packages/headless/src/cli.ts",
    "gate": "tsx packages/headless/src/cli.ts gate",
    "release-gate": "tsx scripts/release/gate.ts",
    "gate:browser": "tsx scripts/browser-gate.ts",
    "dev": "npm run dev -w @gm/shell-browser",
    "build:browser": "npm run build -w @gm/shell-browser",
    "desktop:dev": "cd shells/desktop && tauri dev",
    "desktop:build": "npm run build:browser && cd shells/desktop && tauri build --no-bundle",
    "check:quick": "tsx scripts/check.ts --quick",
    "desktop:installer": "npm run build:browser && cd shells/desktop && tauri build",
    "browsers": "playwright install chromium firefox webkit",
    "playtest": "tsx packages/tools/src/playtest/cli.ts",
    "phase-gates": "tsx packages/tools/src/phase-gates/cli.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/sql.js": "1.4.11",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
